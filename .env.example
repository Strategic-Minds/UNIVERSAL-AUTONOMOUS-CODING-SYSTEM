# ============================================================
# UACS PROJECT ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# --- SUPABASE (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- OPENAI (for AI features) ---
OPENAI_API_KEY=sk-...

# --- BROWSERWORKER (QA testing) ---
BROWSERWORKER_URL=https://browserworker-j4homeh5w-strategic-minds-advisory.vercel.app
BROWSERWORKER_SECRET=your-secret

# --- CHATGPT BRIDGE (visual validation) ---
CHATGPT_BRIDGE_URL=https://xtreme-ai-bridge.vercel.app
BRIDGE_SHARED_SECRET=your-bridge-secret

# --- NOTIFICATIONS ---
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
WHATSAPP_TO=+1XXXXXXXXXX
WHATSAPP_FROM=+15559730487

# --- OUTBOUND SAFETY (keep false until tested) ---
OUTBOUND_ENABLED=false
REAL_OUTBOUND_APPROVED=false
